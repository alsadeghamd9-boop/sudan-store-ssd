# Supabase > Project Settings > Database > Connection string (URI). Use the pooler URI for Vercel.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# Admin access credentials: choose strong unique values. Never expose these as NEXT_PUBLIC_*.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
# At least 32 random bytes; used to sign secure admin session cookies. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Cloudinary > Settings > Product environment credentials
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Optional: configure the intended public base URL for canonical/security integrations
NEXT_PUBLIC_SITE_URL=https://your-store.vercel.app
